###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#teachingAssistant
:teachingAssistant rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Restriction ;
                                 owl:onProperty :teachingAssistant ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Student
                               ] ;
                   rdfs:range [ rdf:type owl:Restriction ;
                                owl:onProperty :teachingAssistant ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Teacher
                              ] .


