:projectName rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#seniorHours
:seniorHours rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :hours ;
             rdfs:domain :CoursePlanning .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#status
:status rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf owl:topDataProperty ;
        rdfs:domain [ rdf:type owl:Restriction ;
                      owl:onProperty :registrationFor ;
                      owl:someValuesFrom :CourseInstance
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :registrationFor ;
                      owl:someValuesFrom :Student
                    ] ;
        rdfs:range xsd:string .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#studyPeriod
:studyPeriod rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :CourseInstance ;
             rdfs:range xsd:int .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#studyYear
:studyYear rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain [ rdf:type owl:Restriction ;
                         owl:onProperty :programCourse ;
                         owl:someValuesFrom :Course
                       ] ,
                       [ rdf:type owl:Restriction ;
