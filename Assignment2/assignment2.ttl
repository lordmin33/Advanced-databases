@base <http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#> .

<http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#assignedHoursFor
:assignedHoursFor rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :CourseInstance ;
                  rdfs:range :assignedHours ,
                             :reportedHours .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#at
:at rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain :Teacher ;
    rdfs:range :assignedHours ,
               :reportedHours .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#directorOf
:directorOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :SeniorTeacher ;
            rdfs:range :Program .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#enrolledIn
:enrolledIn rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Student ;
            rdfs:range :Course .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#examinerOf
:examinerOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :SeniorTeacher ;
            rdfs:range :CourseInstance .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#hasSupervisor
:hasSupervisor rdf:type owl:ObjectProperty ;
               rdfs:domain :Postgraduate ;
               rdfs:range :Teacher .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#instanceOf
:instanceOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Course ;
            rdfs:range :CourseInstance .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#ownedBy
:ownedBy rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :Course ;
         rdfs:range :Program .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#planningFor
:planningFor rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :CourseInstance ;
             rdfs:range :CoursePlanning .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#programCourse
:programCourse rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Course ;
               rdfs:range :Program .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#registrationFor
:registrationFor rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain :Student ;
                 rdfs:range :CourseInstance .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#academicYear
:academicYear rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :CourseInstance ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :programCourse ;
                            owl:someValuesFrom :Course
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :programCourse ;
                            owl:someValuesFrom :Program
                          ] ;
              rdfs:range xsd:int .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#assistantHours
:assistantHours rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :hours ;
                rdfs:domain :CoursePlanning .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#courseCode
:courseCode rdf:type owl:DatatypeProperty ;
            rdfs:domain :Course ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#courseName
:courseName rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Course ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#courseType
:courseType rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain [ rdf:type owl:Restriction ;
                          owl:onProperty :programCourse ;
                          owl:someValuesFrom :Course
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :programCourse ;
                          owl:someValuesFrom :Program
                        ] ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#credits
:credits rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:domain :Course ;
         rdfs:range xsd:float .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#department
:department rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Course ,
                        :Program ,
                        :Teacher ;
            rdfs:range xsd:string .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#division
:division rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :Course ,
                      :Teacher .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#enrolledYear
:enrolledYear rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :Student ;
              rdfs:range xsd:int .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#grade
:grade rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain [ rdf:type owl:Restriction ;
                     owl:onProperty :registrationFor ;
                     owl:someValuesFrom :CourseInstance
                   ] ,
                   [ rdf:type owl:Restriction ;
                     owl:onProperty :registrationFor ;
                     owl:someValuesFrom :Student
                   ] ;
       rdfs:range xsd:int .


###  http://www.semanticweb.org/kemp/ontologies/2019/3/untitled-ontology-1#hours
:hours rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :assignedHours ,
